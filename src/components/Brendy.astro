---
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import { brandGroups, futureNote } from "../data/pickon";
---
<Section id="brendy" class="section brendy" rec="R-UX-07,R-SP-17">
  <div class="container">
    <div class="brendy__head">
      <h2 class="h2">Бренди скла й автохімії</h2>
      <p class="lead">Виробники, чиє скло, автохімію та інструмент ми продаємо.</p>
    </div>
    <div class="groups">
      {brandGroups.map((g, i) => (
        <section class:list={["group", `group--${i + 1}`]} aria-labelledby={`brand-group-${i}`}>
          <h3 class="group__title" id={`brand-group-${i}`}>{g.title}</h3>
          <ul class="wall">{g.items.map((b) => <li lang="en">{b}</li>)}</ul>
        </section>
      ))}
    </div>
    <p class="brendy__more"><FutureLink note={futureNote}>Усі бренди</FutureLink></p>
  </div>
</Section>

<style>
  .brendy__head { display: grid; gap: var(--s-4); max-width: 46rem; }
  .groups { margin-top: var(--s-7); display: grid; gap: var(--s-7); }
  .group { display: grid; gap: var(--s-3); border-top: 1px solid var(--color-border); padding-top: var(--s-4); }
  .group__title { font-family: var(--font-body); font-size: var(--fs-body); font-weight: 600; color: var(--color-muted); }
  .wall { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-5); }
  .wall li { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-index); line-height: 1.2; letter-spacing: -.01em; }
  .group--2 .wall li, .group--3 .wall li { font-size: var(--fs-h3); font-weight: 600; }
  .brendy__more { margin-top: var(--s-5); }

  @media (min-width: 64rem) {
    .groups { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: var(--s-7); }
    .group--1 { grid-column: 1 / -1; }
    .group--2 { grid-column: 1 / span 8; }
    .group--3 { grid-column: 9 / span 4; }
  }
</style>
