---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import FutureLink from "./FutureLink.astro";
import { phones, mainPhone, email, viber, futureNote } from "../data/pickon";

const nav = [
  { href: "#pidbir", label: "Підбір скла" },
  { href: "#dostavka", label: "Доставка й оплата" },
  { href: "#katalog", label: "Каталог" },
  { href: "#brendy", label: "Бренди" },
  { href: "#dlia-sto", label: "Для СТО" },
  { href: "#kontakty", label: "Контакти" },
];
---
<header class="hdr" data-rec="R-UX-05,R-UX-08">
  <div class="hdr__in container">
    <Logo />
    <nav class="hdr__nav" aria-label="Розділи сторінки">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="hdr__lang" aria-label="Мова сайту" role="group">
      <span class="hdr__lang-cur" aria-current="true" lang="uk">УКР</span>
      <FutureLink note={futureNote}><span lang="ru">РУС</span></FutureLink>
    </div>
    <a class="hdr__phone" href={mainPhone.href} data-rec="R-SP-04">{mainPhone.short}</a>
    <a class="btn btn--outline hdr__call" href={mainPhone.href} data-rec="R-UX-05,R-SP-04">
      <Icon name="phone" /><span class="hdr__call-text">Подзвонити</span>
    </a>
    <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <span class="hdr__burger-open"><Icon name="menu" /></span>
      <span class="hdr__burger-close"><Icon name="close" /></span>
      <span class="visually-hidden">Меню</span>
    </button>
  </div>

  <div class="menu" id="menu" hidden>
    <div class="container menu__in">
      <nav aria-label="Розділи сторінки, меню">
        <ul class="menu__nav">
          {nav.map((n) => <li><a href={n.href} data-menu-close>{n.label}</a></li>)}
        </ul>
      </nav>
      <div class="menu__contacts">
        <p class="small muted">Телефони</p>
        <ul>
          {phones.map((p) => <li><a class="menu__phone" href={p.href} data-rec="R-SP-04">{p.display}</a></li>)}
        </ul>
        <div class="menu__row">
          <a class="btn btn--outline" href={viber} data-rec="R-UX-05"><Icon name="chat" />Viber</a>
          <a class="btn btn--outline" href={`mailto:${email}`}><Icon name="mail" />{email}</a>
        </div>
        <div class="menu__lang" role="group" aria-label="Мова сайту">
          <span aria-current="true" lang="uk">УКР</span>
          <FutureLink note={futureNote}><span lang="ru">РУС</span></FutureLink>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: var(--color-bg); border-bottom: 1px solid var(--color-border); }
  .hdr__in { display: flex; align-items: center; gap: var(--s-4); min-height: var(--header-h); }
  .hdr__nav { display: none; margin-inline-start: auto; }
  .hdr__nav ul { display: flex; gap: var(--s-5); }
  .hdr__nav a {
    position: relative; display: inline-flex; align-items: center; min-height: var(--tap);
    font-size: var(--fs-small); font-weight: 500; text-decoration: none; color: var(--color-text);
  }
  .hdr__nav a::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 8px; height: 2px; background: var(--color-accent);
    transform: scaleX(0); transform-origin: left; transition: transform var(--dur-fast) var(--ease-out);
  }
  .hdr__nav a:hover::after, .hdr__nav a:focus-visible::after { transform: scaleX(1); }

  .hdr__lang { display: none; align-items: center; gap: var(--s-3); font-size: var(--fs-small); font-weight: 500; }
  .hdr__lang-cur { color: var(--color-text); font-weight: 600; }
  .hdr__phone {
    display: none; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-body-l);
    text-decoration: none; white-space: nowrap; min-height: var(--tap); align-items: center;
  }
  .hdr__phone:hover { color: var(--color-accent-text); }
  .hdr__call { margin-inline-start: auto; min-height: var(--tap); padding: 0 var(--s-3); }
  .hdr__call-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .hdr__burger {
    display: inline-flex; align-items: center; justify-content: center; width: var(--tap); height: var(--tap);
    border: var(--ring) solid var(--color-text); border-radius: var(--radius); background: var(--color-bg); cursor: pointer;
    transition: transform var(--dur-press) var(--ease-out);
  }
  .hdr__burger:active { transform: scale(.98); }
  .hdr__burger-close { display: none; }
  .hdr__burger[aria-expanded="true"] .hdr__burger-open { display: none; }
  .hdr__burger[aria-expanded="true"] .hdr__burger-close { display: inline; }
  .hdr__burger :global(svg), .hdr__call :global(svg) { width: 22px; height: 22px; }
  /* Without scripting the burger cannot open the menu: hide it, the anchors repeat in the footer. */
  :global(html:not(.js)) .hdr__burger { display: none; }

  .menu { border-top: 1px solid var(--color-border); background: var(--color-bg); max-height: calc(100dvh - var(--header-h)); overflow-y: auto; }
  .menu[hidden] { display: none; }
  .menu__in { display: grid; gap: var(--s-6); padding-block: var(--s-5) var(--s-7); }
  .menu__nav a {
    display: flex; align-items: center; min-height: 52px; font-family: var(--font-display); font-weight: 700;
    font-size: var(--fs-h3); text-decoration: none; border-bottom: 1px solid var(--color-border);
  }
  .menu__contacts { display: grid; gap: var(--s-3); }
  .menu__phone { display: inline-flex; align-items: center; min-height: var(--tap); font-family: var(--font-display); font-weight: 600; font-size: var(--fs-body-l); text-decoration: none; }
  .menu__row { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .menu__lang { display: flex; gap: var(--s-4); align-items: center; font-weight: 600; }

  @media (min-width: 22.5rem) {
    .hdr__lang { display: inline-flex; margin-inline-start: auto; }
    .hdr__call { margin-inline-start: 0; }
  }
  @media (min-width: 48rem) {
    .hdr__phone { display: inline-flex; }
    .hdr__call { padding: 0 var(--s-4); }
    .hdr__call-text { position: static; width: auto; height: auto; overflow: visible; clip: auto; }
  }
  @media (min-width: 80rem) {
    .hdr__nav { display: block; }
    .hdr__lang { margin-inline-start: var(--s-2); }
    .hdr__burger, .menu { display: none !important; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("menu");
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      menu.hidden = !open;
      if (open) menu.querySelector<HTMLElement>("a, [tabindex]")?.focus();
    };
    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    menu.querySelectorAll("[data-menu-close]").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") { setOpen(false); toggle.focus(); }
    });
    window.matchMedia("(min-width: 80rem)").addEventListener("change", (e) => { if (e.matches) setOpen(false); });
  }
</script>
