---
import Base from "../layouts/Base.astro";
import { mainPhone } from "../data/pickon";
---
<Base lang="uk" title="Сторінку не знайдено | Pickon" description="Сторінку не знайдено.">
  <section class="nf container">
    <h1>Такої сторінки немає</h1>
    <p>Поверніться на головну або подзвоніть, підкажемо.</p>
    <p class="nf__actions">
      <a class="btn btn--primary btn--lg" href={import.meta.env.BASE_URL}>На головну</a>
      <a class="btn btn--outline btn--lg" href={mainPhone.href}>Подзвонити {mainPhone.short}</a>
    </p>
  </section>
</Base>
<style>
  .nf { padding-block: var(--section-y); display: grid; gap: var(--s-5); }
  .nf h1 { font-size: var(--fs-h2); font-weight: 800; line-height: 1; text-wrap: balance; }
  .nf__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }
</style>
